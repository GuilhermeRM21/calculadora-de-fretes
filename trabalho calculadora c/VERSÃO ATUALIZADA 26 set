#include <stdio.h>
#include <string.h>

int main() {

    // Dados dos produtos
    char codigo[4][4] = {
        "111",
        "112",
        "113",
        "114"
    };

    char nome[4][20] = {
        "Limao",
        "Maca",
        "Laranja",
        "Melao"
    };

    float peso[4] = {
        0.10,
        0.20,
        0.25,
        1.50
    };

    float preco[4] = {
        1.50,
        3.00,
        2.50,
        9.50
    };

    int opcao;
    int i;
    char codigoBusca[4];
    int encontrado;

    do {

        printf("\n");
        printf("========================================\n");
        printf("          MENU DE PRODUTOS\n");
        printf("========================================\n");
        printf("  1 - Listar todos os produtos\n");
        printf("  2 - Consultar produto por codigo\n");
        printf("  3 - Mostrar produto mais caro\n");
        printf("  4 - Mostrar produto mais pesado\n");
        printf("  0 - Sair\n");
        printf("========================================\n");
        printf("Digite uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {

            case 1:

                printf("\n");
                printf("PRODUTO\n");

                for (i = 0; i < 4; i++) {

                    printf("\nCodigo : %s\n", codigo[i]);
                    printf("Produto: %s\n", nome[i]);
                    printf("Peso   : %.2f kg\n", peso[i]);
                    printf("Preco  : R$ %.2f\n", preco[i]);

                    printf("-----------------------------------------\n");
                }

                break;

            case 2:

                printf("\nDigite o codigo do produto: ");
                scanf("%s", codigoBusca);

                encontrado = 0;

                for (i = 0; i < 4; i++) {

                    if (strcmp(codigoBusca, codigo[i]) == 0) {

                        printf("\nPRODUTO ENCONTRADO\n");
                        printf("Codigo : %s\n", codigo[i]);
                        printf("Produto: %s\n", nome[i]);
                        printf("Peso   : %.2f kg\n", peso[i]);
                        printf("Preco  : R$ %.2f\n", preco[i]);

                        encontrado = 1;
                        break;
                    }
                }

                if (encontrado == 0) {
                    printf("\nProduto nao encontrado!\n");
                }

                break;

            case 3:

                i = 0;

                for (int j = 1; j < 4; j++) {

                    if (preco[j] > preco[i]) {
                        i = j;
                    }
                }

                printf("\nPRODUTO MAIS CARO\n");
                printf("Codigo : %s\n", codigo[i]);
                printf("Produto: %s\n", nome[i]);
                printf("Peso   : %.2f kg\n", peso[i]);
                printf("Preco  : R$ %.2f\n", preco[i]);

                break;

            case 4:

                i = 0;

                for (int j = 1; j < 4; j++) {

                    if (peso[j] > peso[i]) {
                        i = j;
                    }
                }

                printf("\n PRODUTO MAIS PESADO \n");
                printf("Codigo : %s\n", codigo[i]);
                printf("Produto: %s\n", nome[i]);
                printf("Peso   : %.2f kg\n", peso[i]);
                printf("Preco  : R$ %.2f\n", preco[i]);

                break;

            case 0:

                printf("\nEncerrando o programa...\n");
                printf("Obrigado por utilizar o sistema!\n");

                break;

            default:

                printf("\nOpcao invalida! Tente novamente.\n");
        }

    } while (opcao != 0);

    return 0;
}
